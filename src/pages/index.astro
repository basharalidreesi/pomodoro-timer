---
import Layout from '@layouts/Layout.astro';

// check localStorage for an active session, load if found
// start with a new timer if not found
// buttons: start, pause, resume, stop, reset
// when starting: init a new localStorage session, begin countdown (make this base on Date.now() rather than an actual countdown)
// when pausing: save the remaining time to localStorage
// when resuming, continue based on the remaining time
// when stopping: ??? remove localStorage
// when resetting: ??? remove localStorage
// when time is up:
// - notification
// - alarm
// - move to next sesssion
// - add to pomodori score
// on x pomodori completed:
// - +1 set completed
// pomodoro / short break / pomodoro / short break / pomodoro / short break / pomodoro / long break
// 25m / 10m / 25m / 10m / 25m / 10m / 25m / ???
---

<Layout title='Pomodoro'>
    <main>
        <h1 class='sr-only'>Pomodoro</h1>
        <div class='pomodoro'>
            <div class='pomodoro-scale'>
                <div class='spacer'></div>
                {Array.from({ length: 61 }, (_, i) => {
                    const n = i;
                    const isMajor = n % 5 === 0;
                    return (
                        <div
                            class={`pomodoro-mark pomodoro-mark-${isMajor ? 'major' : 'minor'}`}
                            data-value={n}
                        ></div>
                    );
                })}
                <div class='spacer'></div>
            </div>
            <div class='pomodoro-gap'></div>
            <div class='pomodoro-base'>
                <div class='pomodoro-indicator'>
                    <svg viewBox='0 0 100 100' width='100' height='100' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>
                        <polygon points='50, 0 100, 100 0, 100' />
                    </svg>
                </div>
                <!-- <div class='pomodoro-status'>
                    <div class='pomodoro-state' data-value='30'></div>
                    <div class='pomodoro-state' data-value='25'></div>
                    <div class='pomodoro-state' data-value='10'></div>
                    <div class='pomodoro-state' data-value='25'></div>
                    <div class='pomodoro-state' data-value='10'></div>
                    <div class='pomodoro-state' data-value='25'></div>
                    <div class='pomodoro-state' data-value='10'></div>
                    <div class='pomodoro-state' data-value='25'></div>
                </div> -->
            </div>
        </div>
    </main>
</Layout>

<script>
    const scale = document.querySelector<HTMLElement>('.pomodoro-scale');
    const marks = document.querySelectorAll<HTMLElement>('.pomodoro-mark');
    let scrollEndTimeout: any = null;

    const getCentredMark = (): HTMLElement | null => {
        if (!scale) return null;
        const scaleRect = scale.getBoundingClientRect();
        const scaleCentreX = scaleRect.left + scaleRect.width / 2;
        let closest = null;
        let closestDistance = Infinity;
        marks?.forEach((mark) => {
            const rect = mark.getBoundingClientRect();
            const markCentreX = rect.left + rect.width / 2;
            const distance = Math.abs(scaleCentreX - markCentreX);
            if (distance < closestDistance) {
                closest = mark;
                closestDistance = distance;
            }
        });
        return closest;
    };

    scale?.addEventListener('scroll', () => {
        clearTimeout(scrollEndTimeout);
        scrollEndTimeout = setTimeout(() => {
            const centredMark = getCentredMark();
            if (!centredMark) return;
            const number = parseInt(centredMark.getAttribute('data-value') || '', 10)
            if (!isNaN(number) && number > 0) {
                console.log(number);
            }
        }, 300);
    });
</script>

<style lang='scss'>
    @use '@styles/mixins.scss';

    main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pomodoro {
        position: relative;
        display: flex;
        flex-direction: column;
        width: calc((var(--pomodoro-padding-inline) * 2) + ((var(--pomodoro-mark-major-width) + (var(--pomodoro-mark-minor-width) * 4) + (var(--pomodoro-scale-column-gap) * 5)) * var(--pomodoro-width-factor)));
        border-radius: var(--pomodoro-border-radius);
        overflow: hidden;
        box-shadow: 0 0 0 var(--pomodoro-outline-width) var(--pomodoro-outline-colour);
    }
    .pomodoro::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: var(--pomodoro-border-radius);
        box-shadow: inset 0 var(--pomodoro-shadow-offset) var(--pomodoro-shadow-blur) var(--pomodoro-shadow-spread) var(--pomodoro-shadow-colour);
        pointer-events: none;
    }
    .pomodoro-scale {
        display: flex;
        column-gap: var(--pomodoro-scale-column-gap);
        align-items: flex-end;
        height: var(--pomodoro-scale-height);
        padding-inline: var(--pomodoro-padding-inline);
        padding-block: var(--pomodoro-padding-block);
        background-color: var(--pomodoro-scale-background-colour);
        overflow-x: auto;
        @include mixins.no-scrollbar;
    }
    .pomodoro-gap {
        height: var(--pomodoro-gap-height);
        background-color: var(--pomodoro-gap-background-colour);
    }
    .pomodoro-base {
        height: var(--pomodoro-base-height);
        padding-inline: var(--pomodoro-padding-inline);
        padding-block: var(--pomodoro-padding-block);
        background-color: var(--pomodoro-base-background-colour);
    }
    .pomodoro-scale .spacer {
        flex: 0 0 auto;
        width: calc(50% - var(--pomodoro-scale-column-gap) - var(--pomodoro-mark-major-width) / 2);
        height: 1px; // arbitrary
    }
    .pomodoro-scale .pomodoro-mark {
        flex: 0 0 auto;
        position: relative;
    }
    .pomodoro-scale .pomodoro-mark-major {
        width: var(--pomodoro-mark-major-width);
        height: var(--pomodoro-mark-major-height);
        background-color: var(--pomodoro-mark-major-background-colour);
    }
    .pomodoro-scale .pomodoro-mark-major::before {
        content: attr(data-value);
        position: absolute;
        bottom: calc(100% + var(--pomodoro-mark-major-offset-top));
        left: 50%;
        transform: translateX(-50%);
        font-size: var(--pomodoro-mark-font-size);
    }
    .pomodoro-scale .pomodoro-mark-minor {
        width: var(--pomodoro-mark-minor-width);
        height: var(--pomodoro-mark-minor-height);
        background-color: var(--pomodoro-mark-minor-background-colour);
    }
    .pomodoro-base {
        position: relative;
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }
    .pomodoro-base .pomodoro-indicator {
        width: var(--pomodoro-indicator-width);
        height: var(--pomodoro-indicator-height);
    }
    .pomodoro-base .pomodoro-indicator svg {
        display: block;
        width: 100%;
        height: 100%;
        fill: var(--pomodoro-indicator-background-colour);
    }
    .pomodoro-base .pomodoro-status {
        position: absolute;
        left: 0;
        bottom: 0;
        display: flex;
        column-gap: var(--pomodoro-status-column-gap);
        width: 100%;
        padding-block: var(--pomodoro-status-padding-block);
        padding-inline: var(--pomodoro-status-padding-inline);
        background: var(--pomodoro-status-background-colour);
        overflow-x: auto;
        @include mixins.no-scrollbar;
        z-index: 1;
    }
    .pomodoro-base .pomodoro-state {
        flex: 0 0 auto;
        border-radius: 100%;
    }
    .pomodoro-base .pomodoro-state::after {
        content: attr(data-value);
        display: block;
        font-size: var(--pomodoro-state-font-size);
    }

    .sr-only:not(:focus):not(:active) {
        @include mixins.visually-hidden;
    }
</style>