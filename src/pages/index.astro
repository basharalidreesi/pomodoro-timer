---
import Layout from '@layouts/Layout.astro';

// check localStorage for an active session, load if found
// start with a new timer if not found
// buttons: start, pause, resume, stop, reset
// when starting: init a new localStorage session, begin countdown (make this base on Date.now() rather than an actual countdown)
// when pausing: save the remaining time to localStorage
// when resuming, continue based on the remaining time
// when stopping: ??? remove localStorage
// when resetting: ??? remove localStorage
// when time is up:
// - notification
// - alarm
// - move to next sesssion
// - add to pomodori score
// on x pomodori completed:
// - +1 set completed
// pomodoro / short break / pomodoro / short break / pomodoro / short break / pomodoro / long break
// 25m / 10m / 25m / 10m / 25m / 10m / 25m / ???
---

<Layout title='Pomodoro'>
    <main>
        <h1 class='sr-only'>Pomodoro</h1>
        <div class='pomodoro'>
            <div class='pomodoro-scale'>
                <div class='spacer'></div>
                {Array.from({ length: 61 }, (_, i) => {
                    const n = i;
                    const isMajor = n % 5 === 0;
                    return (
                        <div
                            class={`pomodoro-marking pomodoro-marking-${isMajor ? 'major' : 'minor'}`}
                            data-number={n}
                        ></div>
                    );
                })}
                <div class='spacer'></div>
            </div>
            <div class='pomodoro-gap'></div>
            <div class='pomodoro-base'>
                <div class='pomodoro-indicator'>
                    <svg viewBox='0 0 100 100' width='100' height='100' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>
                        <polygon points='50, 0 100, 100 0, 100' />
                    </svg>
                </div>
                <div class='pomodoro-status'>
                    <div class='pomodoro-state pomodoro-state-complete'></div>
                    <div class='pomodoro-state pomodoro-state-complete'></div>
                    <div class='pomodoro-state pomodoro-state-complete'></div>
                    <div class='pomodoro-state pomodoro-state-ongoing'></div>
                </div>
            </div>
        </div>
    </main>
</Layout>

<style lang='scss'>
    @use '@styles/mixins.scss';

    main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .pomodoro {
        position: relative;
        display: flex;
        flex-direction: column;
        width: calc((var(--pomodoro-padding-inline) * 2) + ((var(--pomodoro-marking-major-width) + (var(--pomodoro-marking-minor-width) * 4) + (var(--pomodoro-scale-column-gap) * 5)) * var(--pomodoro-width-factor)));
        border-radius: var(--pomodoro-border-radius);
        overflow: hidden;
        box-shadow: 0 0 0 var(--pomodoro-outline-width) var(--pomodoro-outline-colour);
    }
    .pomodoro::after {
        content: '';
        position: absolute;
        inset: 0;
        box-shadow: inset 0 0 var(--pomodoro-shadow-blur) var(--pomodoro-shadow-spread) var(--pomodoro-shadow-colour);
        pointer-events: none;
    }
    .pomodoro-scale {
        display: flex;
        column-gap: var(--pomodoro-scale-column-gap);
        align-items: flex-end;
        height: var(--pomodoro-scale-height);
        padding-inline: var(--pomodoro-padding-inline);
        padding-block: var(--pomodoro-padding-block);
        background-color: var(--pomodoro-scale-background-colour);
        // overflow-x: hidden;
        // overflow-x: clip;
        overflow-x: auto;
        @include mixins.no-scrollbar;
    }
    .pomodoro-gap {
        height: var(--pomodoro-gap-height);
        background-color: var(--pomodoro-gap-background-colour);
    }
    .pomodoro-base {
        height: var(--pomodoro-base-height);
        padding-inline: var(--pomodoro-padding-inline);
        padding-block: var(--pomodoro-padding-block);
        background-color: var(--pomodoro-base-background-colour);
    }
    .pomodoro-scale .spacer {
        flex: 0 0 auto;
        width: calc(50% - var(--pomodoro-scale-column-gap) - var(--pomodoro-marking-major-width) / 2);
        height: 1px; // arbitrary
    }
    .pomodoro-scale .pomodoro-marking {
        flex: 0 0 auto;
        position: relative;
    }
    .pomodoro-scale .pomodoro-marking-major {
        width: var(--pomodoro-marking-major-width);
        height: var(--pomodoro-marking-major-height);
        background-color: var(--pomodoro-marking-major-background-colour);
    }
    .pomodoro-scale .pomodoro-marking-major::before {
        content: attr(data-number);
        position: absolute;
        bottom: calc(100% + var(--pomodoro-marking-major-offset-top));
        left: 50%;
        transform: translateX(-50%);
        font-size: var(--pomodoro-marking-font-size);
        font-weight: var(--pomodoro-marking-font-weight);
    }
    .pomodoro-scale .pomodoro-marking-minor {
        width: var(--pomodoro-marking-minor-width);
        height: var(--pomodoro-marking-minor-height);
        background-color: var(--pomodoro-marking-minor-background-colour);
    }
    .pomodoro-base {
        position: relative;
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }
    .pomodoro-base .pomodoro-indicator {
        width: var(--pomodoro-indicator-width);
        height: var(--pomodoro-indicator-height);
    }
    .pomodoro-base .pomodoro-indicator svg {
        display: block;
        width: 100%;
        height: 100%;
        fill: var(--pomodoro-indicator-background-colour);
    }
    .pomodoro-base .pomodoro-status {
        position: absolute;
        left: 0;
        bottom: 0;
        display: flex;
        column-gap: var(--pomodoro-status-column-gap);
        width: 100%;
        padding-block: var(--pomodoro-status-padding-block);
        padding-inline: var(--pomodoro-status-padding-inline);
        background: var(--pomodoro-status-background-colour);
        overflow-x: auto;
        @include mixins.no-scrollbar;
        z-index: 1;
    }
    .pomodoro-base .pomodoro-state {
        flex: 0 0 auto;
        width: var(--pomodoro-state-width);
        height: var(--pomodoro-state-height);
        border-radius: 100%;
    }
    .pomodoro-base .pomodoro-state-complete {
        background-color: var(--pomodoro-state-complete-background-colour);
    }
    .pomodoro-base .pomodoro-state-ongoing {
        background-color: var(--pomodoro-state-ongoing-background-colour);
    }

    .sr-only:not(:focus):not(:active) {
        @include mixins.visually-hidden;
    }
</style>