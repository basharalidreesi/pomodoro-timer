---
import '@styles/reset.css';
import '@styles/global.scss';

type Props = {
    title: string;
};

const {
    title,
} = Astro.props;
---

<html lang='en-GB'>
    <head>
        <meta charset='utf-8' />
        <title>{title}</title>
        <meta name='viewport' content='width=device-width,initial-scale=1.0,viewport-fit=cover' />
        <link rel='icon' type='image/png' sizes='32x32' href='/pomodoro-timer/favicon-32x32.png' />
        <link rel='icon' type='image/png' sizes='16x16' href='/pomodoro-timer/favicon-16x16.png' />
        <link rel='manifest' href='/pomodoro-timer/site.webmanifest' />
        <link rel='apple-touch-icon' sizes='180x180' href='/pomodoro-timer/apple-touch-icon.png' />
        <meta name='generator' content={Astro.generator} />
    </head>
    <body>
        <slot />
    </body>
</html>

<style lang='scss'>
    html,
    body {
        background-color: var(--body-background-colour);
    }
    body {
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>